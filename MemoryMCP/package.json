{
  "name": "@tencentdb-agent-memory/mcp-server",
  "version": "0.1.0",
  "description": "P0 stdio MCP server: read-only team memory tools over MemoryCore v3",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "tdai-memory-mcp": "./bin/tdai-memory-mcp.mjs",
    "tdai-reflect": "./bin/tdai-reflect.mjs"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node bin/tdai-memory-mcp.mjs",
    "verify:stdio": "node scripts/verify-stdio.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "examples/",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@tencentdb-agent-memory/memory-sdk-ts-v2": "file:../sdk/memory-core/typescript"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
