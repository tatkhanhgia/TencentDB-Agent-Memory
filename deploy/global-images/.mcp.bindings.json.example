{
  "_comment": "Device token bindings (bootstrapped by start-memory-mcp.sh). identities: \"registry\" resolves the list live from the Panel agent registry — create an agent in the web UI and it appears in the harness picker, no sync needed. 'suggested' preselects the picker choice (one Enter accepts); 'default' skips the question entirely. Replace \"registry\" with a static identities:[...] array (see _static_example) to pin the list; sync-memory-identities.sh can then sync it from the registry.",
  "tok-example-device-token": {
    "identities": "registry",
    "suggested": "coder"
  },
  "_static_example": {
    "identities": [
      {
        "name": "coder",
        "description": "Main coding memory",
        "teamId": "team-xxxxxxxx",
        "agentId": "agt-xxxxxxxx",
        "userId": "usr-xxxxxxxx"
      }
    ]
  }
}
