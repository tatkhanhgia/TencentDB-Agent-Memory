# TDAI Memory MCP — single source of truth for MCP identity + reflect config.
# Copy to .mcp.env and fill in. Consumed by:
#   tdai-memory-mcp.sh     (stdio wrapper — the standard transport for every harness)
#   hooks/tdai-reflect-hook.sh (session-end reflection capture)
#   start-memory-mcp.sh    (legacy opt-in Streamable HTTP on TDAI_MCP_HTTP_PORT)
#
# .mcp.env is gitignored — never commit it.

# ── MemoryCore identity (all required; server is fail-closed) ──────────
# TDAI_AGENT_ID here is only the MACHINE DEFAULT. Per project, both the stdio
# wrapper and the reflect hook resolve the actual identity via _identity.sh:
#   .tdai-project.env at the project root → Panel agent named like the project
#   folder → this default.
TDAI_ENDPOINT=http://127.0.0.1:8420
# Leave empty to fall back to deploy/global-images/.admin-key at runtime.
TDAI_API_KEY=
TDAI_SERVICE_ID=default
TDAI_TEAM_ID=REPLACE_ME
TDAI_AGENT_ID=REPLACE_ME
TDAI_USER_ID=REPLACE_ME
# Optional — leave empty if tasks rotate often.
TDAI_TASK_ID=

# ── Tool surface (defaults: read-only 4 tools; write path is hook-based) ──
TDAI_ENABLE_CAPTURE=false
# Skills = reusable SOPs (4 read-only tools). Turning this on is only half the
# job — MCP never auto-injects a skill catalogue, so also run
# ./install-claude-skill.sh (Claude Code) or paste the Skills paragraph from
# MemoryMCP/examples/rules/ (every other harness). See README.md → Skill 工具.
TDAI_ENABLE_SKILLS=false

# ── Streamable HTTP mode (legacy, opt-in — start-memory-mcp.sh only) ───
TDAI_MCP_HTTP_PORT=8425
TDAI_MCP_HTTP_HOST=127.0.0.1
# Bearer tokens live in .mcp.bindings.json (device token -> identity list),
# bootstrapped automatically on first start-memory-mcp.sh run.

# ── Reflection LLM (hooks/tdai-reflect-hook.sh → tdai-reflect) ──────────
# OpenAI-compatible endpoint. Leave empty to fall back to MEMORY_LLM_* in .env
# (host.docker.internal is rewritten to 127.0.0.1 automatically).
TDAI_REFLECT_LLM_BASE_URL=
TDAI_REFLECT_LLM_API_KEY=
TDAI_REFLECT_LLM_MODEL=
