{
  "_comment": "MCP bindings (the only token source; bootstrapped by start-memory-mcp.sh, synced from the Panel agent registry by sync-memory-identities.sh). Copy to .mcp.bindings.json (gitignored — tokens are secrets). Each token: {identities: [...], default?, suggested?}. No default → the first tool call asks the user to pick (MCP elicitation, falling back to tdai_identity_use); 'suggested' preselects a choice so one Enter accepts it; 'default' skips the question entirely.",
  "tok-example-device-token": {
    "identities": [
      {
        "name": "coder",
        "description": "Main coding memory",
        "teamId": "team-xxxxxxxx",
        "agentId": "agt-xxxxxxxx",
        "userId": "usr-xxxxxxxx"
      },
      {
        "name": "project-x",
        "description": "Project X memory",
        "teamId": "team-xxxxxxxx",
        "agentId": "agt-yyyyyyyy",
        "userId": "usr-xxxxxxxx"
      }
    ],
    "suggested": "coder"
  }
}
