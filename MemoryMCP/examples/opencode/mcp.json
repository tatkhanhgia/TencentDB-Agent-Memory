{
  "mcp": {
    "tdai-memory": {
      "type": "local",
      "command": ["tdai-memory-mcp"],
      "environment": {
        "TDAI_ENDPOINT": "http://127.0.0.1:8420",
        "TDAI_API_KEY": "{env:TDAI_API_KEY}",
        "TDAI_SERVICE_ID": "default",
        "TDAI_TEAM_ID": "{env:TDAI_TEAM_ID}",
        "TDAI_AGENT_ID": "{env:TDAI_AGENT_ID}",
        "TDAI_USER_ID": "{env:TDAI_USER_ID}"
      }
    }
  }
}
